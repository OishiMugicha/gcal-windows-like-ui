# Required for Google connection; leave empty to use the demo only.
# Set in .env.local for development, or in the build environment for deployment.
# Restart the dev server or rebuild after changes.
# OAuth client ID for a Web application, from Google Cloud Console
# Public identifier only. VITE_ values are included in the browser bundle.
# Never put access tokens or client secrets here.
VITE_GOOGLE_CLIENT_ID=
